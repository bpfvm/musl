/*
 * BPF syscall 编号映射。
 *
 * 本 VM 不使用 Linux 原生 syscall 编号，而是用自定义的 BPF_CALL_* 家族
 * （include/bpf_syscall.h：BPF_CALL_BASE=0x10000 + id）。__syscall(SYS_xxx,...)
 * 会把 SYS_xxx 直接当作 call <imm> 的 imm，VM 的 do_syscall 按
 * BPF_CALL_TO_ID 分发到 do_xxx。
 *
 * 因此这里把每个 syscall 号定义成对应的 BPF_CALL_xxx 值。Makefile
 * (Makefile:101-103) 生成 bits/syscall.h 时用 sed 把 NR_ 前缀宏替换成 SYS_
 * 追加到末尾，供 musl 内部 #ifdef SYS_xxx 探测使用（如 __set_thread_area.c
 * 的 #ifdef SYS_set_thread_area）。
 *
 * 分四类：
 *   1) VM 已实现（posix_syscall.cpp 的 switch）：映射到对应 BPF_CALL_*。参数
 *      布局不同的同名 syscall 用独立 id（dup2/dup3、mkdir/mkdirat、readlink/
 *      readlinkat、renameat/renameat2 各自独立 handler），避免共用 handler 读参
 *      错位。
 *   2) VM 未实现但 musl 引用：映射到 BPF_CALL_BASE 占位。包括 musl 直接
 *      syscall() 调用的、经 socketcall_cp/__socketcall 宏（SYS_##name 拼接）
 *      间接引用的网络系列、以及 musl #ifdef SYS_xxx 路径选择型（删除会改
 *      变 musl 运行时分支，曾导致 test_sigstop 动态版 fork/信号路径回归）。
 *      占位让 musl 编译通过；运行时若被调用，VM do_syscall default 返回
 *      -ENOSYS，musl 据此降级或返回错误。
 *   3) VM 未实现且 musl 完全不引用：不定义 NR 宏。用户代码 #ifdef SYS_xxx
 *      探测会正确失败、syscall(SYS_xxx,...) 编译报错，避免误用（运行时静默
 *      ENOSYS）。判定「完全不引用」须同时覆盖直接引用与宏间接引用，仅 grep
 *      字面 SYS_xxx 会漏掉 socketcall 系列，需以「删除后 make 是否报 undeclared
 *      identifier」为 ground truth。
 *   4) 参数布局与 *at handler 不兼容的旧版别名（stat/lstat/fstat/fchmod/utime/
 *      utimes/chdir/statx/tgkill 等）：不定义 NR 宏。它们与对应 *at id 参数个数
 *      不同（如 stat 2参 vs fstatat 4参），共用 handler 会参数错位。libc 封装由
 *      src 各模块 bpf/ 覆盖版用正确的 *at syscall 实现（见下方各段注释）。
 *
 * 注意：syscall 号定义必须用 NR_ 前缀宏（sed 据此生成 SYS_ 供 musl 探测），
 * 但注释里不能写出该前缀的完整双下划线形式——sed 会把含该子串的注释行也
 * 替换并追加到生成的 bits/syscall.h 末尾，造成乱码/重复定义。
 */

#ifndef BPF_CALL_BASE
#include <bpf_syscall.h>
#endif

