#ifndef syscall

/* 这个 push 故意不配对 pop（直到 TU 末尾）。
 * -Wint-conversion 在 clang 16+ / C2x 默认是 error。BPF 上 syscall 是宏，
 * 形参全是 long（见下 __bpf_syscallN），用户写 `syscall(SYS_x, &ptr)` 传指针
 * 会在调用点触发指针→long 转换。pragma 是词法作用域，必须覆盖到这些调用点，
 * 故不能在本头结束时 pop——否则抑制只保护下面的 inline 函数体（函数指针强转），
 * 保护不到用户代码里 `syscall(...)` 宏展开后的实参→形参转换。BPF 是 64 位统一
 * 整数 ABI，指针与 long 同宽，该转换无损，压成 warning 是安全的。 */
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wpedantic"
#pragma GCC diagnostic ignored "-Wint-conversion"

static inline long __bpf_syscall0(unsigned long call)
{
    return ((long (*)(void))call)();
}

static inline long __bpf_syscall1(unsigned long call, long a)
{
    return ((long (*)(long))call)(a);
}

static inline long __bpf_syscall2(unsigned long call, long a, long b)
{
    return ((long (*)(long, long))call)(a, b);
}

static inline long __bpf_syscall3(unsigned long call, long a, long b, long c)
{
    return ((long (*)(long, long, long))call)(a, b, c);
}

static inline long __bpf_syscall4(unsigned long call, long a, long b, long c, long d)
{
    return ((long (*)(long, long, long, long))call)(a, b, c, d);
}

static inline long __bpf_syscall5(unsigned long call, long a, long b, long c, long d, long e)
{
    return ((long (*)(long, long, long, long, long))call)(a, b, c, d, e);
}

static inline long __bpf_syscall6(unsigned long call, long a, long b, long c, long d, long e, long f)
{
    return ((long (*)(long, long, long, long, long, long))call)(a, b, c, d, e, f);
}

/* C++ 指针重载：上面的 -Wint-conversion pragma 在 C 下能把"指针→long 隐式转换"压成
 * 警告，但 C++ 里这是硬错误（不是 warning，pragma 抑制不了）。C++ 代码（如 libc++abi
 * 的 cxa_guard_impl.h 用 syscall(SYS_futex, int*, ...) 传指针）需这些重载才能编。
 * 仅 C++ 启用（C 不支持函数重载）。任一参数为 void* 时命中对应重载，指针经 intptr_t
 * 转 long（BPF 64 位统一整数 ABI，无损，与原 pragma 意图一致）。 */
#ifdef __cplusplus
#include <stdint.h>
static inline long __bpf_syscall1(unsigned long call, void *a)
{ return __bpf_syscall1(call, (long)(intptr_t)a); }
static inline long __bpf_syscall2(unsigned long call, void *a, long b)
{ return __bpf_syscall2(call, (long)(intptr_t)a, b); }
static inline long __bpf_syscall2(unsigned long call, long a, void *b)
{ return __bpf_syscall2(call, a, (long)(intptr_t)b); }
static inline long __bpf_syscall3(unsigned long call, void *a, long b, long c)
{ return __bpf_syscall3(call, (long)(intptr_t)a, b, c); }
static inline long __bpf_syscall3(unsigned long call, long a, void *b, long c)
{ return __bpf_syscall3(call, a, (long)(intptr_t)b, c); }
static inline long __bpf_syscall3(unsigned long call, long a, long b, void *c)
{ return __bpf_syscall3(call, a, b, (long)(intptr_t)c); }
static inline long __bpf_syscall4(unsigned long call, void *a, long b, long c, long d)
{ return __bpf_syscall4(call, (long)(intptr_t)a, b, c, d); }
static inline long __bpf_syscall4(unsigned long call, long a, void *b, long c, long d)
{ return __bpf_syscall4(call, a, (long)(intptr_t)b, c, d); }
static inline long __bpf_syscall4(unsigned long call, long a, long b, void *c, long d)
{ return __bpf_syscall4(call, a, b, (long)(intptr_t)c, d); }
static inline long __bpf_syscall4(unsigned long call, long a, long b, long c, void *d)
{ return __bpf_syscall4(call, a, b, c, (long)(intptr_t)d); }
static inline long __bpf_syscall5(unsigned long call, void *a, long b, long c, long d, long e)
{ return __bpf_syscall5(call, (long)(intptr_t)a, b, c, d, e); }
static inline long __bpf_syscall5(unsigned long call, long a, void *b, long c, long d, long e)
{ return __bpf_syscall5(call, a, (long)(intptr_t)b, c, d, e); }
static inline long __bpf_syscall5(unsigned long call, long a, long b, void *c, long d, long e)
{ return __bpf_syscall5(call, a, b, (long)(intptr_t)c, d, e); }
static inline long __bpf_syscall5(unsigned long call, long a, long b, long c, void *d, long e)
{ return __bpf_syscall5(call, a, b, c, (long)(intptr_t)d, e); }
static inline long __bpf_syscall5(unsigned long call, long a, long b, long c, long d, void *e)
{ return __bpf_syscall5(call, a, b, c, d, (long)(intptr_t)e); }
static inline long __bpf_syscall6(unsigned long call, void *a, long b, long c, long d, long e, long f)
{ return __bpf_syscall6(call, (long)(intptr_t)a, b, c, d, e, f); }
static inline long __bpf_syscall6(unsigned long call, long a, void *b, long c, long d, long e, long f)
{ return __bpf_syscall6(call, a, (long)(intptr_t)b, c, d, e, f); }
static inline long __bpf_syscall6(unsigned long call, long a, long b, void *c, long d, long e, long f)
{ return __bpf_syscall6(call, a, b, (long)(intptr_t)c, d, e, f); }
static inline long __bpf_syscall6(unsigned long call, long a, long b, long c, void *d, long e, long f)
{ return __bpf_syscall6(call, a, b, c, (long)(intptr_t)d, e, f); }
static inline long __bpf_syscall6(unsigned long call, long a, long b, long c, long d, void *e, long f)
{ return __bpf_syscall6(call, a, b, c, d, (long)(intptr_t)e, f); }
static inline long __bpf_syscall6(unsigned long call, long a, long b, long c, long d, long e, void *f)
{ return __bpf_syscall6(call, a, b, c, d, e, (long)(intptr_t)f); }
#endif

/* 不 pop：见上面 push 处注释 */

/* 数参数个数（0..6），把 syscall(ID, args...) 分发到 __bpf_syscallN(ID, args...) */
#define ___bpf_syscall_nth(_, _1, _2, _3, _4, _5, _6, N, ...) N
#define ___bpf_syscall_narg(...) \
    ___bpf_syscall_nth(_, ##__VA_ARGS__, 6, 5, 4, 3, 2, 1, 0)
#define ___bpf_syscall_cat_x(a, b) a##b
#define ___bpf_syscall_cat(a, b) ___bpf_syscall_cat_x(a, b)
#define syscall(call, ...) \
    ___bpf_syscall_cat(__bpf_syscall, ___bpf_syscall_narg(__VA_ARGS__))(call, ##__VA_ARGS__)

#endif /* !syscall */
